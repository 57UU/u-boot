# Splash screen
CONFIG_BMP_32BPP=y
CONFIG_VIDEO_BMP_RLE8=y
CONFIG_VIDEO_LOGO=y
CONFIG_SPLASH_SCREEN=y
CONFIG_SPLASH_SCREEN_ALIGN=y
CONFIG_NO_FB_CLEAR=n
CONFIG_CMD_BMP=y

# Menu
CONFIG_CMD_BOOTMENU=y
CONFIG_CMD_PAUSE=y

# Autoboot
CONFIG_AUTOBOOT_USE_MENUKEY=y
CONFIG_AUTOBOOT_MENUKEY=27
CONFIG_AUTOBOOT_PROMPT="\e[7m\e[4m\e[999;0H Hit <ESC> to enter menu (%ds left) \e[0m\e[0;0H"
CONFIG_BOOT_RETRY=y
CONFIG_BOOT_RETRY_TIME=1
CONFIG_RETRY_BOOTCMD=y
CONFIG_USE_PREBOOT=y

# Ensure that EFI capsule updates are enabled
CONFIG_EFI_RUNTIME_UPDATE_CAPSULE=y
CONFIG_EFI_CAPSULE_ON_DISK=y
CONFIG_EFI_CAPSULE_ON_DISK_EARLY=y
CONFIG_EFI_CAPSULE_FIRMWARE_RAW=y

# Useful for debugging SMBIOS data
CONFIG_CMD_SMBIOS=y
CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y
CONFIG_CMD_UFETCH=y

# Clear the framebuffer before drawing
CONFIG_NO_FB_CLEAR=n

# Set the namespace GUID so that there are no conflicts with U-Boot 
# image GUIDs on devices that use dynamic UUIDs for capsule updates.
# This namespace GUID identifies tauchgang community builds of U-Boot!
CONFIG_EFI_CAPSULE_NAMESPACE_GUID="a39b9978-2477-4522-9488-4c918c991327"
